# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=

# ─── Session ────────────────────────────────────────────────────────────────
SESSION_SECRET=

# ─── Anthropic (Claude AI) ───────────────────────────────────────────────────
# Provided automatically by Replit AI Integrations — no key required in development
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=
AI_INTEGRATIONS_ANTHROPIC_API_KEY=

# ─── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_EXCELLENCE_LAB_PRICE_ID=
STRIPE_EVIDENCE_VAULT_PRICE_ID=

# ─── Google Drive (service account JSON as single-line string) ───────────────
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ─── Gmail OAuth (for email sending via Nodemailer) ──────────────────────────
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ─── JWT Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRY=7d

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ─── Disclaimer ──────────────────────────────────────────────────────────────
CURRENT_DISCLAIMER_VERSION=1.0
