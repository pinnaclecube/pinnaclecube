# Evidence Package worker (spec §11a).
#
# Runs the package generation queue off Vercel, in a container that has the native
# toolchain the pipeline needs (LibreOffice, poppler, tesseract, python). Deploy to
# any container host (Render / Railway / Fly / Cloud Run / a VM). Give it the same
# env as the API: DATABASE_URL, GOOGLE_SERVICE_ACCOUNT_JSON, ANTHROPIC_API_KEY,
# RESEND_API_KEY, RESEND_FROM_EMAIL, FRONTEND_URL.
#
# Build context excludes are in Dockerfile.package-worker.dockerignore (BuildKit
# uses that in place of the repo's .dockerignore, which omits scripts/ and some
# workspace packages this worker needs).

FROM node:22-bookworm-slim

# Native toolchain: office->PDF, PDF rasterization, OCR, python extractor deps.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libreoffice-writer libreoffice-calc libreoffice-impress \
      poppler-utils tesseract-ocr \
      python3 python3-pip fonts-dejavu \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir --break-system-packages \
      pdfplumber python-docx openpyxl Pillow pytesseract cffi

WORKDIR /app
RUN npm install -g pnpm@10 tsx

# The whole monorepo (minus the Dockerfile-specific ignore) so pnpm can resolve
# every workspace package the lockfile references, plus scripts/ and lib/.
COPY . .
RUN pnpm install --frozen-lockfile || pnpm install

# extract.py is resolved from this absolute path (cwd-independent).
ENV PACKAGE_EXTRACT_SCRIPT=/app/scripts/extract.py
ENV NODE_ENV=production

# The worker runs TypeScript directly via tsx (@workspace/* export their src).
CMD ["tsx", "artifacts/api-server/src/package-worker.ts"]
