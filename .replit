modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["resend:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 19917
externalPort = 3000

[[ports]]
localPort = 19918
externalPort = 3001

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
CURRENT_DISCLAIMER_VERSION = "1.0"
STRIPE_PRICE_EXCELLENCE_LAB = "price_1TCnF4AEwPUC4JLmC8TygsXe"
STRIPE_PRICE_EVIDENCE_ENGINE = "price_1TCnGPAEwPUC4JLmhOExwZap"
