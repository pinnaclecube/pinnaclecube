+#!/usr/bin/env bash
+# Prepares a Claude Code (web/cloud) session: install workspace deps and build
+# the composite lib type outputs so `pnpm run typecheck` works immediately.
+# Tolerant by design — a failed prep step should never block the session.
+set -u
+
+cd "$(dirname "$0")/.." || exit 0
+
+if ! command -v pnpm >/dev/null 2>&1; then
+  corepack enable >/dev/null 2>&1 || true
+fi
+
+echo "[session-start] installing dependencies…"
+pnpm install --frozen-lockfile >/dev/null 2>&1 || \
+  echo "[session-start] pnpm install reported issues (continuing)"
+
+echo "[session-start] building lib type outputs…"
+./node_modules/.bin/tsc --build lib/db lib/shared lib/api-zod >/dev/null 2>&1 || \
+  echo "[session-start] tsc --build of core libs reported issues (continuing)"
+
+echo "[session-start] ready."
+exit 0
